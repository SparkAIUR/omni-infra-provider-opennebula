{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["v1alpha1", "v1alpha2"]
    },
    "flavor": {
      "type": "string",
      "description": "Named flavor from the provider runtime configuration."
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "type": "string"
        },
        "vcpu": {
          "type": "integer",
          "minimum": 1
        },
        "memoryMiB": {
          "type": "integer",
          "minimum": 1
        },
        "rootDiskGiB": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "templateName": {
      "type": "string"
    },
    "datastore": {
      "type": "string"
    },
    "networks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": ["auto", "manual"]
          },
          "model": {
            "type": "string"
          }
        }
      }
    },
    "networkContextMode": {
      "type": "string",
      "enum": ["auto", "manual"]
    },
    "staticNetwork": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "mac": {
            "type": "string"
          },
          "ip": {
            "type": "string"
          },
          "gateway": {
            "type": "string"
          },
          "dns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "rootDiskGiB": {
      "type": "integer",
      "minimum": 1
    },
    "firmware": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["uefi", "bios"]
        },
        "secureBoot": {
          "type": "boolean"
        }
      }
    },
    "graphics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "tags": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "type": "string"
        },
        "vendor": {
          "type": "string"
        },
        "device": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "profile": {
          "type": "string"
        }
      }
    },
    "imagePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["reuse-only", "reuse-or-import"]
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string"
        },
        "cluster": {
          "type": "string"
        },
        "vmGroup": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      }
    },
    "additionalDisks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "sizeGiB": {
            "type": "integer",
            "minimum": 1
          },
          "format": {
            "type": "string",
            "enum": ["qcow2", "raw"]
          }
        },
        "required": ["sizeGiB"]
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deleteMode": {
          "type": "string",
          "enum": ["terminate", "normal", "hard"]
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "networks"
  ]
}
