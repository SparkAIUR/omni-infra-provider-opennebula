# Example config for .assh/scripts/setup-production-ceph-storage.sh
# Copy this file outside the repository or to a gitignored location and fill in
# the real production values before execution.

SSH_USER="root"

# Set to true when OpenNebula commands must run via SSH on the production frontend.
OPENNEBULA_USE_SSH="true"
OPENNEBULA_FRONTEND_HOST="prod-fe-01"
OPENNEBULA_TALOS_TEMPLATE_NAME="talos-omni-base"
OPENNEBULA_EXPECT_LOCAL_ROOT_SCHED_DS="ID = 0"

# Optional inventory hints. Leave empty to capture only list-level output.
OPENNEBULA_HOST_IDS="0 1 2"
OPENNEBULA_DATASTORE_IDS="1 100 103 104"
OPENNEBULA_TEMPLATE_NAMES="talos-omni-base"

INVENTORY_HOSTS=(
  "prod-fe-01"
  "prod-hv-01"
  "prod-hv-02"
)

CEPH_HOSTS=(
  "prod-fe-01"
  "prod-hv-01"
  "prod-hv-02"
)

HOST_PRIVATE_IP_MAP=(
  "prod-fe-01=10.10.0.10"
  "prod-hv-01=10.10.0.11"
  "prod-hv-02=10.10.0.12"
)

# Space-separated device list per host. Keep each mapping as one quoted entry.
HOST_OSD_DEVICE_MAP=(
  "prod-fe-01=/dev/vdb"
  "prod-hv-01=/dev/vdb"
  "prod-hv-02=/dev/vdb"
)

CEPH_BOOTSTRAP_HOST="prod-fe-01"
CEPH_BOOTSTRAP_MON_IP="10.10.0.10"
CEPH_PUBLIC_NETWORK="10.10.0.0/24"
CEPH_CLUSTER_NETWORK="10.10.0.0/24"
CEPH_FSID=""
CEPH_IMAGE=""
CEPH_ALLOW_FQDN_HOSTNAMES="true"
CEPH_POOL_SIZE="3"
CEPH_POOL_MIN_SIZE="2"
CEPH_MGR_PLACEMENT_COUNT="2"
CEPH_MDS_PLACEMENT_COUNT="2"

# If unset, the script derives this list from HOST_PRIVATE_IPS for CEPH_HOSTS.
CEPH_CLIENT_MONITORS=""

CEPH_RBD_POOL_IMAGES="one-images"
CEPH_RBD_POOL_SYSTEM="one-system"
CEPH_RBD_POOL_CSI="one-csi"
CEPHFS_METADATA_POOL="one-cephfs-meta"
CEPHFS_DATA_POOL="one-cephfs-data"
CEPHFS_NAME="one-cephfs"
CEPHFS_ROOT_PATH="/volumes"
CEPHFS_SUBVOLUME_GROUP="csi"
CEPHFS_MOUNT_OPTIONS=""

CEPH_OPENNEBULA_CLIENT_ID="opennebula"
CEPH_CSI_ADMIN_CLIENT_ID="opennebula-csi"
CEPH_CSI_NODE_CLIENT_ID="opennebula-csi-node"

# Optional fixed UUID. Leave blank to generate and persist under the output dir.
CEPH_LIBVIRT_SECRET_UUID=""
CEPH_LIBVIRT_SECRET_NAME="client.opennebula secret"

# These hosts receive the Ceph client keyring and libvirt secret registration.
OPENNEBULA_CEPH_CLIENT_HOSTS=(
  "prod-fe-01"
  "prod-hv-01"
  "prod-hv-02"
)

# If left blank, the script uses OPENNEBULA_CEPH_CLIENT_HOSTS joined by spaces.
OPENNEBULA_CEPH_BRIDGE_LIST=""
OPENNEBULA_STAGING_DIR="/var/tmp/opennebula-ceph"
OPENNEBULA_RBD_FORMAT="2"

# Only set these when the runtime will really mount the custom path on all
# OpenNebula bridge/client hosts and future CSI consumers.
CEPH_USE_CEPH_CONF="false"
CEPH_CONF_PATH="/etc/ceph/ceph.conf"
OPENNEBULA_CEPH_KEY_PATH=""

OPENNEBULA_CEPH_IMAGE_DATASTORE_NAME="ceph-images"
OPENNEBULA_CEPH_SYSTEM_DATASTORE_NAME="ceph-system"
OPENNEBULA_CSI_RBD_DATASTORE_NAME="one-csi"
OPENNEBULA_CSI_CEPHFS_DATASTORE_NAME="one-csi-cephfs"

# Optional fixed datastore ID if you must reserve it ahead of time. Leave blank
# in normal use and the script will resolve the created system datastore ID.
OPENNEBULA_CEPH_SYSTEM_DATASTORE_FIXED_ID=""
