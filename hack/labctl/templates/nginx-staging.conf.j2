server {
  listen 80;
  server_name on.lab.sprkinfra.com omni.on.lab.sprkinfra.com dex.on.lab.sprkinfra.com;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name on.lab.sprkinfra.com;
  ssl_certificate /etc/ssl/staging/fullchain.pem;
  ssl_certificate_key /etc/ssl/staging/privkey.pem;
  location / {
    proxy_pass http://127.0.0.1:2616;
  }
}

server {
  listen 443 ssl http2;
  server_name omni.on.lab.sprkinfra.com;
  ssl_certificate /etc/ssl/staging/fullchain.pem;
  ssl_certificate_key /etc/ssl/staging/privkey.pem;
  location / {
    proxy_pass http://127.0.0.1:8080;
  }
}

server {
  listen 443 ssl http2;
  server_name dex.on.lab.sprkinfra.com;
  ssl_certificate /etc/ssl/staging/fullchain.pem;
  ssl_certificate_key /etc/ssl/staging/privkey.pem;
  location / {
    proxy_pass http://127.0.0.1:5556;
  }
}

